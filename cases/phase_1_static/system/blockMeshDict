vertices
(
    #codeStream
    {
	codeInclude
	#{
	    #include "pointField.H"
	#};

	code
	#{
	    const dictionary & d = dict;
  	    const scalar chord = readScalar(d.lookup("chord"));
	    const scalar tOverC = readScalar(d.lookup("tOverC"));
	    const scalar ffRatio = readScalar(d.lookup("farfieldRatio"));
	    const scalar zSpan = readScalar(d.lookup("zSpan"));
	    const scalar xMid = readScalar(d.lookup("xMid"));	    

	
	    auto yt = [&](scalar x)
	    {
		scalar xc = x/c;
	 	return 5*tOverC*
		(
		   0.2969*Foam::sqrt(xc)
		   - 0.1260*xc
		   - 0.3516*Foam::sqr(xc)
		   + 0.2834*Foam::pow3(xc)
		   - 1.015*Foam::pow4(xc)

		);

	    };


	   point WE = (0, 0, 0);
	   point NE = (xMid, yt(xMid), 0);
	   point EE = (chord, 0, 0);
  	   point NE = (xMid, -yt(xMid), 0);

	   point oWE = (-10*chord, 0, 0);
           point oNE1 = (xMid, 10*chord, 0);
           point oNE2 = (21*chord, 10*chord, 0);
           point oSE1 = (xMid, -10*chord, 0);
           point oSE2 = (21*chord, -10*chord, 0);
           point oEE = (21*chord, 0, 0);

	   pointField pts(20);
	   pointField layer0({WE, NE, EE, NE, oWE, oNE1, oNE2,
			      oEE, oSE2, oSE1});

	   forAll(layer0, i)
	   {
	      pts[i] = layer0[i];
	      pts[i+10] = layer0[i] + point(0, 0, zSpan);
	   }


	   os << pts;

	#}
	
    }
);

