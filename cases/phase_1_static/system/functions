FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#includeFunc streamlinesLine
(
    name=streamlines,
    start=(-0.0205 0.001 0.00001),
    end=(-0.0205 0.0251 0.00001),
    nPoints=10,
    fields=(p k U)
)

#includeFunc writeObjects(kEpsilon:G)

 forceCoeffs
 {
    type            forceCoeffs;
    libs            ("libforces.so");

    writeControl    timeStep;
    writeInterval   100;

    log             true;

    patches         (airfoil);

    rho             rhoInf;
    rhoInf          1.225;

    liftDir         (0.087156 0.99619 0);
    dragDir         (0.99619 -0.087156 0);
    pitchAxis       (0 0 1);

    CofR            (0.25 0 0);

    magUInf         15;

    lRef            1;

    Aref            0.01;

}

residuals
{
    type   	    residuals;
    libs	    ("libutilityFunctionObjects.so");

    fields	    (p U k epsilon);

    writeControl    timeStep;
    writeInterval   100;
}

